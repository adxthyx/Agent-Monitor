# LLM providers (both OpenAI-compatible)
DEEPSEEK_API_KEY=
NEBIUS_API_KEY=

# Monitor database (docker-compose default)
DATABASE_URL=postgresql+psycopg://agentmon:agentmon@localhost:5433/agentmon

# Optional: Slack-compatible incoming webhook for alerts
ALERT_WEBHOOK_URL=

# Optional: email alerts over SMTP (smtp_security: starttls | ssl | none)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
ALERT_EMAIL_FROM=agentmon@localhost
ALERT_EMAIL_TO=

# Receiver for webhook-style targets (they POST replies here). Public URL if the target reaches it via a tunnel/proxy.
CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=8200
CALLBACK_PUBLIC_URL=

# Demo agent
DEMO_AGENT_PORT=8100
