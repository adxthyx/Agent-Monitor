[10.871032, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"stale_kb\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[10.871344, "o", "\u001b[33m$\u001b[39m "]
[10.871373, "o", "curl -s -o /dev/null -w 'GET /health -> HTTP %{http_code}\\n' localhost:8100/health\r\n"]
